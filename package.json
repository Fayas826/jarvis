{
  "name": "jarvis-enterprise-backend",
  "version": "1.0.0",
  "description": "Enterprise-grade JARVIS backend with Node.js, TypeScript, BullMQ, and Docker",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --watch \"src/**/*.ts\" --exec \"npx ts-node\" src/index.ts",
    "build": "tsc",
    "worker": "npx ts-node src/workers/index.ts",
    "test": "jest"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "axios": "^1.6.0",
    "bullmq": "^4.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "mongoose": "^7.6.3",
    "morgan": "^1.10.0",
    "winston": "^3.11.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.20",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.7",
    "@types/node": "^20.8.9",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
